---
// Halaman LP whitelist (Meta/Google) — dipakai oleh route ID & EN.
// Tipis: pilih data per (platform, lang), render section yang sama.
import BaseLayout from '@layouts/BaseLayout.astro';
import LpHeader from '@components/layout/LpHeader.astro';
import LpHero from '@components/sections/lp/LpHero.astro';
import LpWhyPlatform from '@components/sections/lp/LpWhyPlatform.astro';
import LpComparison from '@components/sections/lp/LpComparison.astro';
import LpPhotoVisit from '@components/sections/lp/LpPhotoVisit.astro';
import IndustriesGrid from '@components/sections/IndustriesGrid.astro';
import LpTestimonials from '@components/sections/lp/LpTestimonials.astro';
import LpPromoBanner from '@components/sections/lp/LpPromoBanner.astro';
import LpShortForm from '@components/sections/lp/LpShortForm.astro';
import { META_LP, INDUSTRIES_LP, INDUSTRY_LP_HEADING } from '@data/whitelist-lp';
import { serviceJsonLd, breadcrumbJsonLd } from '@lib/seo';
import { site } from '@data/site';
import { getLang } from '@i18n/utils';

interface Props { platform: 'meta' | 'google' }
const { platform } = Astro.props;
const lang = getLang(Astro.currentLocale);

// Tampilan & konteks digabung: kedua permalink dirender identik (konten + SEO).
// Yang beda hanya penanda channel (canonical URL, GTM/Pixel) + header (khusus Google).
const content = META_LP[lang];

// SEO "1 konteks" — sama untuk /whitelist/metaads & /whitelist/gads.
const seo = lang === 'en'
  ? {
      title: 'Whitelist Ad Account Rental (Meta & Google Ads) — Tentaklik',
      description: 'Rent a Meta & Google Ads whitelist account at Tentaklik: stable, resilient accounts, no spending limit, minimal ban risk, and appeal support via the official partner line.',
      keywords: ['whitelist ad account', 'meta ads account rental', 'google ads account rental', 'meta whitelist account', 'google whitelist account'],
      crumbWhitelist: 'Whitelist Account',
    }
  : {
      title: 'Sewa Akun Whitelist (Meta & Google Ads) — Tentaklik',
      description: 'Sewa akun whitelist Meta & Google Ads di Tentaklik: akun stabil & tangguh, tanpa limit spending, minim risiko banned, dan support appeal via jalur partner resmi.',
      keywords: ['akun whitelist', 'sewa akun meta ads', 'sewa akun google ads', 'akun whitelist meta', 'akun whitelist google'],
      crumbWhitelist: 'Akun Whitelist',
    };

const slug = platform === 'google' ? 'whitelist/gads' : 'whitelist/metaads';
const path = lang === 'en' ? `/en/${slug}` : `/${slug}`;
const url = `${site.url}${path}`;
const crumbSewa = lang === 'en' ? 'Account Rental' : 'Sewa Akun';
const crumbHome = lang === 'en' ? 'Home' : 'Beranda';

// Semua LP pakai header LP sederhana (Header situs dimatikan via bareHeader).

const jsonLd = [
  serviceJsonLd({
    name: seo.title,
    description: seo.description,
    url,
    serviceType: 'Meta & Google Ads Whitelist Account Rental',
  }),
  breadcrumbJsonLd([
    { name: crumbHome, url: lang === 'en' ? `${site.url}/en` : site.url },
    { name: crumbSewa, url: `${site.url}${lang === 'en' ? '/en' : ''}/layanan/sewa-akun` },
    { name: seo.crumbWhitelist, url },
  ]),
];
---
<BaseLayout
  title={seo.title}
  description={seo.description}
  active="layanan"
  bareLayout
  bareHeader
  jsonLd={jsonLd}
  keywords={seo.keywords}
  preloadHeroSrc="true"
  gtmId={platform === 'google' ? 'GTM-N6FD2GVL' : 'GTM-T2FDL7NM'}
>
    <Fragment slot="head">
      <!-- Meta Pixel Code -->
      <script is:inline>
        !function(f,b,e,v,n,t,s)
        {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
        n.callMethod.apply(n,arguments):n.queue.push(arguments)};
        if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
        n.queue=[];t=b.createElement(e);t.async=!0;
        t.src=v;s=b.getElementsByTagName(e)[0];
        s.parentNode.insertBefore(t,s)}(window, document,'script',
        'https://connect.facebook.net/en_US/fbevents.js');
        fbq('init', '1341980327384883');
        fbq('track', 'PageView');
      </script>
      <!-- End Meta Pixel Code -->
    </Fragment>
    <noscript><img height="1" width="1" style="display:none"
      src="https://www.facebook.com/tr?id=1341980327384883&ev=PageView&noscript=1"
    /></noscript>

  <LpHeader platform={platform} lang={lang} />
  <LpHero
    eyebrow={content.hero.eyebrow}
    title={content.hero.title}
    titleAccent={content.hero.titleAccent}
    desc={content.hero.desc}
    ctaText={content.cta.btn}
    ctaHref={`#shortform-${platform}`}
  />
  <LpWhyPlatform 
    platform={content.platform} 
    heading={content.whyHeading} 
    sub={content.whySub} 
    items={content.whyItems} 
  />
  <LpComparison platform={content.platform} />
  <IndustriesGrid 
    items={INDUSTRIES_LP[lang]} 
    heading={INDUSTRY_LP_HEADING[lang]} 
    bg="warm" 
    center 
    variant="premium"
  />
  <LpPhotoVisit 
    heading={content.photoHeading} 
    sub={content.photoSub} 
    photos={content.photos} 
    variant="meta" 
  />
  <LpTestimonials items={content.testimonials.map(t => ({ data: t }))} />
  <LpPromoBanner lang={lang} startingPrice={lang === 'en' ? '$31' : 'Rp150.000'} />
  <LpShortForm platform={platform} />
</BaseLayout>
