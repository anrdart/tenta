---
// Strip partner resmi untuk LP whitelist: Meta, Google, TikTok.
// Pakai aset yang sudah ada di repo (public/assets) + icon TikTok komponen.
import TikTok from '@components/icons/TikTok.astro';
import { getLang } from '@i18n/utils';

const lang = getLang(Astro.currentLocale);
const heading = lang === 'en' ? 'Official Partners' : 'Partner Resmi';
const sub = lang === 'en'
  ? 'Trusted across the platforms where you advertise.'
  : 'Dipercaya di platform tempat Anda beriklan.';
---
<section class="lp-partners" aria-labelledby="lp-partners-heading">
  <div class="container">
    <p id="lp-partners-heading" class="lp-partners-eyebrow">{heading}</p>
    <div class="lp-partners-row">
      <div class="lp-partner-item">
        <img src="/assets/partner-meta.png" alt="Meta Business Partner" height="40" loading="lazy" decoding="async" />
      </div>
      <span class="lp-partner-sep" aria-hidden="true"></span>
      <div class="lp-partner-item">
        <picture>
          <source type="image/avif" srcset="/assets/partner-google.avif" />
          <source type="image/webp" srcset="/assets/partner-google.webp" />
          <img src="/assets/partner-google.png" alt="Google Partner" height="40" loading="lazy" decoding="async" />
        </picture>
      </div>
      <span class="lp-partner-sep" aria-hidden="true"></span>
      <div class="lp-partner-item lp-partner-tiktok">
        <TikTok size={26} />
        <span class="lp-partner-label">TikTok Partner</span>
      </div>
    </div>
    <p class="lp-partners-sub">{sub}</p>
  </div>
</section>

<style>
  .lp-partners {
    padding: 48px 0;
    background: white;
    border-top: 1px solid var(--ink-100);
    border-bottom: 1px solid var(--ink-100);
  }
  .lp-partners-eyebrow {
    text-align: center;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--ink-400);
    margin: 0 0 24px 0;
  }
  .lp-partners-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 32px;
    flex-wrap: wrap;
  }
  .lp-partner-item {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 44px;
    opacity: 0.85;
    transition: opacity 0.2s ease;
  }
  .lp-partner-item:hover { opacity: 1; }
  .lp-partner-item img { height: 40px; width: auto; display: block; }
  .lp-partner-tiktok {
    gap: 8px;
    color: var(--ink-900);
    font-weight: 800;
    font-size: 20px;
  }
  .lp-partner-label { font-size: 18px; letter-spacing: -0.5px; }
  .lp-partner-sep {
    width: 1px;
    height: 32px;
    background: var(--ink-100);
  }
  .lp-partners-sub {
    text-align: center;
    font-size: 14px;
    color: var(--ink-500);
    margin: 24px 0 0 0;
  }
  @media (max-width: 640px) {
    .lp-partners-row { gap: 20px; }
    .lp-partner-item { height: 34px; }
    .lp-partner-item img { height: 30px; }
    .lp-partner-sep { display: none; }
    .lp-partner-tiktok { font-size: 17px; }
  }
</style>
