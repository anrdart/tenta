---
interface Props {
  // Layout lama (2 harga coret) — dipakai halaman USD. Bila keduanya diisi → mode promo.
  originalPrice?: string;
  promoPrice?: string;
  // Layout baru (default LP): harga sewa mulai + note "akun tangguh".
  startingPrice?: string;
  lang?: 'en' | 'id';
}
const { originalPrice, promoPrice, startingPrice = 'Rp150.000' } = Astro.props;
const lang = Astro.props.lang ?? (Astro.currentLocale === 'en' ? 'en' : 'id');
const isEn = lang === 'en';

// Mode promo lama hanya aktif bila kedua harga dikirim eksplisit (halaman USD).
const showPromo = Boolean(originalPrice && promoPrice);
const isUsd = showPromo && originalPrice!.startsWith('$');
const badgeText = showPromo
  ? (isUsd ? '⚡ LIMITED OFFER' : '⚡ PROMO TERBATAS')
  : (isEn ? '⚡ BEST RATE' : '⚡ HARGA TERBAIK');
const noteText = showPromo
  ? (isUsd ? '*Special promo price for today\'s submissions' : '*Harga promo khusus pengajuan minggu ini')
  : (isEn ? 'Resilient accounts — ban-free' : 'Akun tangguh, bebas banned');
const startLabel = isEn ? 'Rent from' : 'Sewa mulai dari';
const perAccount = isEn ? '/ account' : '/ akun';
---
<div class="lp-promo-container">
  <div class="lp-promo-badge">
    {badgeText}
  </div>
  {showPromo ? (
    <div class="lp-promo-pricing">
      <div class="lp-promo-item normal">
        <span class="lp-label">{isUsd ? 'Regular price' : 'Biaya normal'}</span>
        <span class="lp-price"><s>{originalPrice}</s></span>
      </div>
      <div class="lp-promo-divider"></div>
      <div class="lp-promo-item promo">
        <span class="lp-label">{isUsd ? 'Promo access' : 'Promo akses'}</span>
        <span class="lp-price">{promoPrice}</span>
      </div>
    </div>
  ) : (
    <div class="lp-promo-starting">
      <span class="lp-label">{startLabel}</span>
      <span class="lp-start-price">{startingPrice} <span class="lp-start-unit">{perAccount}</span></span>
    </div>
  )}
  <p class={`lp-promo-note ${showPromo ? '' : 'lp-promo-note-strong'}`}>{noteText}</p>
</div>

<style>
  .lp-promo-container {
    background: linear-gradient(135deg, var(--orange-50) 0%, #FFFDFB 100%);
    border: 1.5px solid var(--orange-100);
    border-radius: var(--radius-xl);
    padding: 24px 20px 18px 20px;
    max-width: 480px;
    margin: 40px auto 20px auto;
    text-align: center;
    position: relative;
    box-shadow: 0 4px 20px rgba(253, 110, 33, 0.04);
    box-sizing: border-box;
  }
  .lp-promo-badge {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--orange-500);
    color: white;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1px;
    padding: 4px 12px;
    border-radius: 99px;
    box-shadow: 0 2px 8px rgba(253, 110, 33, 0.2);
    white-space: nowrap;
  }
  .lp-promo-pricing {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 24px;
    margin-top: 8px;
  }
  .lp-promo-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: 1;
  }
  .lp-promo-item .lp-label {
    font-size: 11px;
    color: var(--ink-400);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 4px;
    font-weight: 600;
  }
  .lp-promo-item.normal .lp-price {
    font-size: 16px;
    color: var(--ink-400);
    font-weight: 500;
  }
  .lp-promo-item.normal .lp-price s {
    text-decoration: line-through;
    color: var(--ink-400);
  }
  .lp-promo-item.promo .lp-price {
    font-size: 20px;
    color: var(--orange-600);
    font-weight: 800;
  }
  .lp-promo-divider {
    width: 1.5px;
    height: 36px;
    background: var(--orange-200);
    align-self: center;
    opacity: 0.7;
  }
  .lp-promo-note {
    font-size: 11px;
    color: var(--ink-400);
    margin: 12px 0 0 0;
    font-style: italic;
    font-weight: 500;
  }

  /* Layout baru: harga sewa mulai */
  .lp-promo-starting {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    margin-top: 8px;
  }
  .lp-promo-starting .lp-label {
    font-size: 11px;
    color: var(--ink-400);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-weight: 600;
  }
  .lp-start-price {
    font-size: 28px;
    font-weight: 800;
    color: var(--orange-600);
    line-height: 1.1;
  }
  .lp-start-unit {
    font-size: 15px;
    font-weight: 600;
    color: var(--ink-400);
  }
  .lp-promo-note-strong {
    font-style: normal;
    font-weight: 700;
    color: var(--orange-600);
    font-size: 13px;
  }
  .lp-promo-note-strong::before {
    content: "✓ ";
    font-weight: 800;
  }

  @media (max-width: 480px) {
    .lp-start-price { font-size: 24px; }
  }

  @media (max-width: 480px) {
    .lp-promo-container {
      margin: 32px 16px 16px 16px;
      padding: 20px 16px 14px 16px;
    }
    .lp-promo-pricing {
      gap: 16px;
    }
    .lp-promo-item.promo .lp-price {
      font-size: 18px;
    }
  }
</style>
