---
import CompIcon from '@components/sections/lp/CompIcon.astro';
interface Props {
  platform: 'meta' | 'google';
  lang?: 'en' | 'id';
}

const { platform, lang = Astro.currentLocale === 'en' ? 'en' : 'id' } = Astro.props;
const isEn = lang === 'en';

const comparisons = [
  {
    leftIcon: 'user',
    leftText: isEn ? 'Suitable for general use' : 'Cocok untuk penggunaan umum',
    rightIcon: 'users',
    rightText: isEn ? 'Fit for active advertisers' : 'Cocok untuk bisnis yang aktif beriklan'
  },
  {
    leftIcon: 'settings',
    leftText: isEn ? 'Self-managed' : 'Dikelola secara mandiri',
    rightIcon: 'headset',
    rightText: isEn ? 'Gets support and guidance' : 'Mendapat dukungan dan pendampingan'
  },
  {
    leftIcon: 'chat',
    leftText: isEn ? 'Limited support' : 'Support terbatas',
    rightIcon: 'chat-orange',
    rightText: isEn ? 'Highly responsive support' : 'Dukungan yang lebih responsif'
  },
  {
    leftIcon: 'clipboard',
    leftText: isEn ? 'Fit for basic needs' : 'Cocok untuk kebutuhan dasar',
    rightIcon: 'chart',
    rightText: isEn ? 'Ready to scale up with your business' : 'Lebih siap mendukung kebutuhan bisnis yang berkembang'
  }
];
---
<section class="lp-comparison-section" id={`comparison-${platform}`}>
  <div class="container">
    
    <div class="comp-header reveal">
      <h2 class="comp-title">
        {isEn ? 'What is the Difference' : 'Apa Bedanya'} <span class="text-orange">{platform === 'meta' ? (isEn ? 'From Regular Accounts?' : 'Dengan Akun Biasa?') : (isEn ? 'From Regular Accounts?' : 'Dengan Akun Biasa?')}</span>
      </h2>
      <p class="comp-sub">{isEn ? 'Choose the solution that best fits your business needs.' : 'Pilih solusi yang paling sesuai untuk kebutuhan bisnis Anda.'}</p>
    </div>

    <!-- Dots Decor left -->
    <div class="dots-decor dots-left">
      <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
        <circle cx="2" cy="2" r="2" fill="#F97316"/>
        <circle cx="14" cy="2" r="2" fill="#F97316"/>
        <circle cx="26" cy="2" r="2" fill="#F97316"/>
        <circle cx="38" cy="2" r="2" fill="#F97316"/>
        <circle cx="2" cy="14" r="2" fill="#F97316"/>
        <circle cx="14" cy="14" r="2" fill="#F97316"/>
        <circle cx="26" cy="14" r="2" fill="#F97316"/>
        <circle cx="38" cy="14" r="2" fill="#F97316"/>
        <circle cx="2" cy="26" r="2" fill="#F97316"/>
        <circle cx="14" cy="26" r="2" fill="#F97316"/>
        <circle cx="26" cy="26" r="2" fill="#F97316"/>
        <circle cx="38" cy="26" r="2" fill="#F97316"/>
      </svg>
    </div>

    <div class="comp-table reveal">
      <!-- Header Row -->
      <div class="comp-row comp-header-row">
        <div class="comp-col comp-col-left header-col">
          <div class="header-icon-box">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
            </svg>
          </div>
          <h3>{isEn ? 'Regular Account' : 'Akun Biasa'}</h3>
        </div>
        
        <div class="comp-col comp-col-right header-col right-header-bg">
          <div class="header-icon-box orange-box">
             {platform === 'meta' ? (
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 12c-2-2.67-4-4-6-4a4 4 0 1 0 0 8c2 0 4-1.33 6-4Zm0 0c2 2.67 4 4 6 4a4 4 0 1 0 0-8c-2 0-4 1.33-6 4Z"/>
                </svg>
             ) : (
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                   <path stroke-linecap="round" stroke-linejoin="round" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z" />
                </svg>
             )}
          </div>
          <h3>{isEn ? 'Whitelist Account' : 'Akun Whitelist'}</h3>
        </div>
      </div>

      <!-- Item Rows -->
      {comparisons.map((item) => (
        <div class="comp-row">
          <div class="comp-col comp-col-left">
            <div class="item-icon-box">
              <CompIcon id={item.leftIcon as any} />
            </div>
            <p class="item-text">{item.leftText}</p>
          </div>
          
          <!-- VS Badge -->
          <div class="vs-badge">VS</div>

          <div class="comp-col comp-col-right">
            <div class="item-icon-box orange-text">
              <CompIcon id={item.rightIcon as any} />
            </div>
            <p class="item-text">{item.rightText}</p>
          </div>
        </div>
      ))}
      
    </div>

    <!-- Mobile grouped layout: semua Akun Biasa, lalu semua Akun Whitelist -->
    <div class="comp-mobile reveal">
      <div class="comp-mobile-group comp-mobile-left">
        <div class="comp-mobile-group-head">
          <div class="header-icon-box">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
            </svg>
          </div>
          <h3>{isEn ? 'Regular Account' : 'Akun Biasa'}</h3>
        </div>
        {comparisons.map((item) => (
          <div class="comp-mobile-item">
            <div class="item-icon-box">
              <CompIcon id={item.leftIcon as any} />
            </div>
            <p class="item-text">{item.leftText}</p>
          </div>
        ))}
      </div>

      <div class="comp-mobile-vs">VS</div>

      <div class="comp-mobile-group comp-mobile-right">
        <div class="comp-mobile-group-head">
          <div class="header-icon-box orange-box">
            {platform === 'meta' ? (
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 12c-2-2.67-4-4-6-4a4 4 0 1 0 0 8c2 0 4-1.33 6-4Zm0 0c2 2.67 4 4 6 4a4 4 0 1 0 0-8c-2 0-4 1.33-6 4Z"/>
              </svg>
            ) : (
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                 <path stroke-linecap="round" stroke-linejoin="round" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z" />
              </svg>
            )}
          </div>
          <h3>{isEn ? 'Whitelist Account' : 'Akun Whitelist'}</h3>
        </div>
        {comparisons.map((item) => (
          <div class="comp-mobile-item">
            <div class="item-icon-box orange-text">
              <CompIcon id={item.rightIcon as any} />
            </div>
            <p class="item-text">{item.rightText}</p>
          </div>
        ))}
      </div>
    </div>
    
    <!-- Dots Decor right -->
    <div class="dots-decor dots-right">
      <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
        <circle cx="2" cy="2" r="2" fill="#F97316"/>
        <circle cx="14" cy="2" r="2" fill="#F97316"/>
        <circle cx="26" cy="2" r="2" fill="#F97316"/>
        <circle cx="38" cy="2" r="2" fill="#F97316"/>
        <circle cx="2" cy="14" r="2" fill="#F97316"/>
        <circle cx="14" cy="14" r="2" fill="#F97316"/>
        <circle cx="26" cy="14" r="2" fill="#F97316"/>
        <circle cx="38" cy="14" r="2" fill="#F97316"/>
        <circle cx="2" cy="26" r="2" fill="#F97316"/>
        <circle cx="14" cy="26" r="2" fill="#F97316"/>
        <circle cx="26" cy="26" r="2" fill="#F97316"/>
        <circle cx="38" cy="26" r="2" fill="#F97316"/>
      </svg>
    </div>

  </div>
</section>

<style>
  .lp-comparison-section {
    padding-top: 100px;
    padding-bottom: 100px;
    background: #f8fafc; /* matching the previous section */
    position: relative;
    overflow: hidden;
  }
  
  .comp-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 60px auto;
  }
  
  .comp-title {
    font-size: 42px;
    font-weight: 800;
    line-height: 1.2;
    color: var(--ink-900);
    margin: 0 0 16px 0;
  }
  
  .text-orange {
    color: var(--orange-600);
  }
  
  .comp-sub {
    font-size: 16.5px;
    line-height: 1.6;
    color: var(--ink-600);
    margin: 0;
  }

  .comp-table {
    max-width: 900px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
    background: white;
    border-radius: 20px;
    border: 1.5px solid var(--orange-100);
    box-shadow: 0 10px 40px rgba(0,0,0,0.04);
  }

  .comp-row {
    display: flex;
    position: relative;
    border-bottom: 1px dashed #e2e8f0;
  }
  .comp-row:last-child {
    border-bottom: none;
  }

  .comp-col {
    flex: 1;
    padding: 24px 32px;
    display: flex;
    align-items: center;
    gap: 16px;
    min-height: 90px;
  }

  .comp-col-left {
    background: #f8fafc; /* soft grey */
  }

  .comp-col-right {
    background: white;
    /* Soft orange outer glow for the right column wrapper is handled by pseudo element below */
  }

  /* First row radiuses */
  .comp-row:first-child .comp-col-left {
    border-top-left-radius: 20px;
  }
  .comp-row:first-child .comp-col-right {
    border-top-right-radius: 20px;
  }
  
  /* Last row radiuses */
  .comp-row:last-child .comp-col-left {
    border-bottom-left-radius: 20px;
  }
  .comp-row:last-child .comp-col-right {
    border-bottom-right-radius: 20px;
  }

  /* VS Badge */
  .vs-badge {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 36px;
    height: 36px;
    background: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    font-weight: 800;
    color: var(--orange-600);
    box-shadow: 0 4px 15px rgba(0,0,0,0.06);
    z-index: 10;
  }

  /* Header Row Styling */
  .comp-header-row {
    border-bottom: 1px solid #e2e8f0;
  }
  .comp-header-row .comp-col {
    padding: 32px 32px;
    justify-content: center;
  }
  .comp-header-row .comp-col-left {
    background: #f1f5f9; /* slightly darker grey for header */
  }
  
  .right-header-bg {
    background: #fff4ed !important; /* Soft orange bg */
  }

  .header-icon-box {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: white;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ink-500);
    box-shadow: 0 4px 10px rgba(0,0,0,0.05);
    flex-shrink: 0;
  }
  .header-icon-box svg { width: 24px; height: 24px; }
  
  .orange-box {
    background: var(--orange-500);
    color: white;
  }

  .header-col h3 {
    font-size: 24px;
    font-weight: 800;
    margin: 0;
    color: var(--ink-900);
  }
  .comp-header-row .comp-col-right h3 {
    color: var(--orange-600);
  }

  /* Items Styling */
  .item-icon-box {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #e2e8f0; /* darker grey */
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ink-600);
    flex-shrink: 0;
  }
  .orange-text {
    background: var(--orange-50);
    color: var(--orange-600);
  }
  .item-icon-box svg { width: 22px; height: 22px; }

  .item-text {
    font-size: 15px;
    font-weight: 600;
    line-height: 1.4;
    color: var(--ink-800);
    margin: 0;
  }
  .comp-col-right .item-text {
    color: var(--ink-900);
    font-weight: 700;
  }

  /* Decor */
  .dots-decor {
    position: absolute;
    z-index: 1;
    opacity: 0.3;
  }
  .dots-left {
    left: 8%;
    top: 150px;
  }
  .dots-right {
    right: 8%;
    bottom: 50px;
  }

  /* Right column outer shadow to create separation */
  .comp-table::after {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 50%;
    box-shadow: 15px 0px 50px rgba(249, 115, 22, 0.08);
    border-radius: 0 20px 20px 0;
    pointer-events: none;
  }

  /* Mobile grouped layout (default visible; disembunyikan di desktop) */
  .comp-mobile { display: none; }

  /* Responsive */
  @media (max-width: 768px) {
    /* Sembunyikan tabel interleaved di mobile, tampilkan grup berurutan */
    .comp-table { display: none; }
    .comp-mobile { display: block; }

    .comp-mobile-group {
      background: white;
      border: 1.5px solid var(--orange-100);
      border-radius: 16px;
      padding: 20px;
      margin-bottom: 0;
      box-shadow: 0 4px 15px rgba(0,0,0,0.04);
    }
    .comp-mobile-vs {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 32px;
      height: 32px;
      margin: -8px auto -8px;
      background: var(--orange-500);
      color: white;
      font-size: 12px;
      font-weight: 800;
      border-radius: 50%;
      box-shadow: 0 2px 8px rgba(253, 110, 33, 0.3);
      position: relative;
      z-index: 2;
    }
    .comp-mobile-right {
      border-color: var(--orange-300);
      background: linear-gradient(135deg, var(--orange-50) 0%, #FFFDFB 100%);
    }
    .comp-mobile-group-head {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 16px;
      padding-bottom: 12px;
      border-bottom: 1px dashed #e2e8f0;
    }
    .comp-mobile-group-head h3 {
      font-size: 18px;
      font-weight: 800;
      margin: 0;
      color: var(--ink-900);
    }
    .comp-mobile-right .comp-mobile-group-head h3 {
      color: var(--orange-600);
    }
    .comp-mobile-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 8px 0;
    }

    .comp-row {
      flex-direction: column;
      border-bottom: none;
      margin-bottom: 24px;
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 4px 15px rgba(0,0,0,0.04);
      background: white;
      border: 1.5px solid var(--orange-100);
    }
    
    .comp-table {
      background: transparent;
      box-shadow: none;
    }
    .comp-table::after {
      display: none;
    }
    
    .comp-col {
      min-height: auto;
      padding: 24px;
    }
    .comp-header-row .comp-col {
      padding: 24px;
      justify-content: flex-start;
    }
    
    .comp-col-left, .comp-col-right {
      border-radius: 0 !important;
    }

    .vs-badge {
      width: 32px;
      height: 32px;
      font-size: 12px;
    }
    
    .comp-title {
      font-size: 32px;
    }
  }

  @media (max-width: 640px) {
    .lp-comparison-section {
      padding-top: 60px;
      padding-bottom: 60px;
    }
    .dots-decor {
      display: none; /* Hide dots on small mobile to avoid horizontal scrolling */
    }
  }
</style>
